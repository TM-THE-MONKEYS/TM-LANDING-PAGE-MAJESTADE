{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "devl": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.majestadepersonalizados.com.br"
        }
      ],
      "destination": "https://majestadepersonalizados.com.br/:path*",
      "permanent": true
    }
  ]
}
